# Cấu hình PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=Product-Catalog

# Cấu hình JWT Security
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cấu hình Cache Redis (TTL tính bằng giây)
CACHE_TTL_PRODUCT_LIST=60
CACHE_TTL_PRODUCT_DETAIL=60
CACHE_TTL_CATEGORY=1800
