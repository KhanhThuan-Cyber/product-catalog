# Cơ sở dữ liệu
DATABASE_URL=postgresql+psycopg2://postgres:POSTGRES_PASSWORD@localhost:5432/Product-Catalog

# JWT
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Redis
REDIS_URL=redis://localhost:6379/0

# Cache TTL (giây) - có thể bỏ qua để dùng default trong config.py
# CACHE_TTL_PRODUCT_DETAIL=600
# CACHE_TTL_PRODUCT_LIST=300
# CACHE_TTL_CATEGORY=1800

# Rate limiting (giây + số request) - có thể bỏ qua để dùng default
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_WINDOW=900
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_REGISTER_WINDOW=3600

# Refresh token
# REFRESH_TOKEN_EXPIRE_DAYS=7
